generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String     @id @default(uuid())
  username   String     @unique
  password   String
  longFills  Fills[]    @relation(name: "longUser")
  shortFills Fills[]    @relation(name: "shortUser")
  orders     Orders[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Asset {
  id        String   @id @default(uuid())
  name      String
  img       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Fills {
  id           String   @id @default(uuid())
  longUserId   String
  shortUserId  String
  makerId      String
  takerId      String
  longOrderId  String
  shortOrderId String
  price        String
  quantity     String
  market       String
  longUser     User     @relation(name: "longUser", fields: [longUserId], references: [id])
  shortUser    User     @relation(name: "shortUser", fields: [shortUserId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Orders {
  id        String      @id @default(uuid())
  quantity  String
  price     String
  side      side
  type      type
  status    orderStatus @default(open)
  userId    String
  market    String
  user      User        @relation(fields: [userId], references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Candle {
  market    String
  timestamp DateTime

  open      String
  high      String
  low       String
  close     String
  volume    String

  @@id([market, timestamp])
}

enum side {
  long
  short
}

enum type {
  limit
  market
}

enum orderStatus {
  open
  partiallyFilled
  Filled
  Close
  Cancel
}
