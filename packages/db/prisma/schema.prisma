generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(uuid())
  username   String   @unique
  password   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  longFills  Fills[]  @relation("longUser")
  shortFills Fills[]  @relation("shortUser")
  orders     Orders[]
}

model Asset {
  id        String   @id @default(uuid())
  name      String
  img       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Fills {
  id           String   @id @default(uuid())
  longUserId   String
  shortUserId  String
  makerId      String
  takerId      String
  longOrderId  String
  shortOrderId String
  price        String
  quantity     String
  market       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  longUser     User     @relation("longUser", fields: [longUserId], references: [id])
  shortUser    User     @relation("shortUser", fields: [shortUserId], references: [id])
}

model Orders {
  id             String      @id @default(uuid())
  quantity       String
  price          String
  side           side
  type           type
  userId         String
  market         String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  status         orderStatus @default(open)
  filledQuantity String      @default("0")
  user           User        @relation(fields: [userId], references: [id])
}

model Candle {
  market    String
  open      String
  high      String
  low       String
  close     String
  volume    String
  timestamp DateTime

  @@id([market, timestamp])
}

enum side {
  long
  short
}

enum type {
  limit
  market
}

enum orderStatus {
  open
  partiallyFilled
  Filled
  Close
  Cancel
}
